<MudDialog DisableSidePadding="true">
    <DialogContent>
        <div class="pa-6 text-center">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="mx-auto mb-4">
                <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Large" />
            </MudAvatar>
            
            <MudText Typo="Typo.h5" Class="font-weight-bold mb-1">Room Invitation</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">You've been invited to join a game session.</MudText>

            <div class="pa-4 rounded-lg bg-surface border mb-6 text-left">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">GAME</MudText>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">@GameName</MudChip>
                </div>
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">ROOM CODE</MudText>
                    <MudText Typo="Typo.body2" Class="font-weight-bold">@RoomCode</MudText>
                </div>
            </div>

            <div class="d-flex gap-3">
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Error" 
                           FullWidth="true" 
                           OnClick="Cancel"
                           Class="py-2">
                    Decline
                </MudButton>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Success" 
                           FullWidth="true" 
                           OnClick="Confirm"
                           Class="py-2">
                    Accept & Join
                </MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public string GameName { get; set; } = string.Empty;
    [Parameter] public string RoomCode { get; set; } = string.Empty;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}