@using PlayX.Services
@inject PeerJsService PeerService
@implements IDisposable

<div class="d-flex flex-column align-items-center pa-4">
    <MudText Typo="Typo.h5" Class="font-weight-bold">Who is the Imposter?</MudText>
    <MudCard Class="pa-6 mt-4 text-center" Style="max-width: 400px; width: 100%;">
        <MudText Typo="Typo.h6" Class="mb-3">Secret Word:</MudText>
        <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold">Coffee</MudText>
    </MudCard>
</div>

@code {
    [Parameter] public bool IsOnline { get; set; }
    [Parameter] public bool IsHost { get; set; }
    public void Dispose() { }
}