@inject IJSRuntime JS
@inject PeerJsService PeerService
@implements IDisposable

<div class="d-flex flex-column align-items-center justify-center pa-4">
    <div class="mb-4 text-center">
        <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">@GameStatus</MudText>
        @if (IsOnline && !IsMyTurn && !IsGameOver)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="rounded-pill my-2" Style="width: 150px;" />
        }
    </div>

    <!-- Chess Board Container -->
    <div id="chess-board-container" class="elevation-4 rounded-lg overflow-hidden"></div>
</div>

@code {
    [Parameter] public bool IsOnline { get; set; }
    [Parameter] public bool IsHost { get; set; }
    [Parameter] public bool IsSolo { get; set; }

    private string GameStatus = "Your Turn (White)";
    private bool IsMyTurn = true;
    private bool IsGameOver = false;
    private DotNetObjectReference<Chess>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        if (IsOnline)
        {
            PeerService.OnDataReceived += HandleNetworkData;
            IsMyTurn = IsHost; // Host plays White, Client plays Black
            GameStatus = IsMyTurn ? "Your Turn (White)" : "Opponent's Turn (Black)";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initializeChessGame", _dotNetRef, new { IsOnline, IsHost, IsSolo });
        }
    }

    private async void HandleNetworkData(string data)
    {
        if (data.StartsWith("CHESS_FEN:"))
        {
            var parts = data.Substring(10).Split('|');
            var fen = parts[0];
            var gameOverFlag = parts.Length > 1 && bool.Parse(parts[1]);

            await JS.InvokeVoidAsync("loadChessFen", fen);

            IsGameOver = gameOverFlag;
            if (IsGameOver)
            {
                // If opponent sent the game-over FEN, you lost (or it's checkmate against you)
                GameStatus = "Checkmate! You Lost.";
            }
            else
            {
                IsMyTurn = true;
                GameStatus = "Your Turn!";
            }
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnMoveCompleted(string fen, bool isGameOverStatus)
    {
        IsGameOver = isGameOverStatus;

        if (IsGameOver)
        {
            GameStatus = "Checkmate! You Won!";
        }
        else if (IsOnline)
        {
            IsMyTurn = false;
            GameStatus = "Waiting for opponent...";
        }
        else if (IsSolo && !IsGameOver)
        {
            IsMyTurn = false;
            GameStatus = "AI is thinking...";
            StateHasChanged();
            
            await Task.Delay(400);
            await JS.InvokeVoidAsync("makeAiMove");
            IsMyTurn = true;
            GameStatus = "Your Turn!";
        }

        // Pack FEN and game over status together so the receiver knows immediately
        if (IsOnline)
        {
            await PeerService.SendAsync($"CHESS_FEN:{fen}|{IsGameOver}");
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        if (IsOnline)
        {
            PeerService.OnDataReceived -= HandleNetworkData;
        }
        _dotNetRef?.Dispose();
    }
}