@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager _navigationManager

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" @ref="@_mudThemeProvider" Theme="_customTheme" />
<MudDialogProvider />
<MudSnackbarProvider />

<style>
    /* Smooth transition effects when toggling themes */
    body, .mud-appbar, .mud-drawer, .mud-main-content, .mud-card, .mud-paper, .mud-button-root, .mud-input-control {
        transition: background-color 0.3s ease-in-out, color 0.3s ease-in-out, border-color 0.3s ease-in-out, box-shadow 0.3s ease-in-out !important;
    }
</style>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6" Class="ml-3">@GetAppBarTitle(_navigationManager.Uri)</MudText>
        <MudSpacer/>
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                       Color="Color.Inherit" 
                       OnClick="@ToggleTheme" 
                       aria-label="Toggle Dark or Light Theme"/>
    </MudAppBar>
    
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4 my-sm-6 px-3 px-sm-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    private bool _isDarkMode;
    private MudThemeProvider _mudThemeProvider = null!;

    private readonly MudTheme _customTheme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Background = new MudColor("#FFF5F5"), 
            Surface = new MudColor("#FFFFFF"), 
            AppbarBackground = new MudColor("#FFFFFF"), 
            DrawerBackground = new MudColor("#FFF5F5"), 

            Primary = new MudColor("#D23B68"), 
            Secondary = new MudColor("#62626C"), 
            Tertiary = new MudColor("#F3A0B7"), 
            Info = new MudColor("#2196F3"), 

            TextPrimary = new MudColor("#1A0A10"), 
            TextSecondary = new MudColor("#755E68"), 
            AppbarText = new MudColor("#1A0A10"), 
            DrawerText = new MudColor("#1A0A10"),

            LinesDefault = new MudColor("#E8D5DA"), 
            TableLines = new MudColor("#E8D5DA"),
            ActionDefault = new MudColor("#755E68")
        },
        PaletteDark = new PaletteDark()
        {
            Background = new MudColor("#120205"), 
            Surface = new MudColor("#1F070B"), 
            AppbarBackground = new MudColor("#1F070B"),
            DrawerBackground = new MudColor("#120205"),

            Primary = new MudColor("#FF4D6D"), 
            Secondary = new MudColor("#FFB3C1"), 
            Tertiary = new MudColor("#C9184A"), 
            Info = new MudColor("#90CAF9"),

            TextPrimary = new MudColor("#FFF0F2"), 
            TextSecondary = new MudColor("#A3858A"), 
            AppbarText = new MudColor("#FFF0F2"),
            DrawerText = new MudColor("#FFF0F2"),

            LinesDefault = new MudColor("#3B181E"), 
            TableLines = new MudColor("#3B181E"),
            ActionDefault = new MudColor("#A3858A")
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Roboto", "Helvetica", "Arial", "sans-serif" },
            }
        }
    };

    protected override void OnInitialized()
    {
        _navigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
    }

    private string GetAppBarTitle(string uri)
    {
        var relativePath = _navigationManager.ToBaseRelativePath(uri).ToLower();

        return relativePath switch
        {
            "" or "/" => "PlayX",
            "/selection" or "selection" => "PlayX",
            _ => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(relativePath.Replace("/", " - "))
        };
    }

    public void Dispose()
    {
        _navigationManager.LocationChanged -= OnLocationChanged;
    }
}