@page "/"
@inject NavigationManager Navigation

<div class="playx-home-container">
    <div class="hero-section">
        <div class="badge-wrapper mud-elevation-z2">
            <span class="live-indicator"></span>
            <span class="badge-text">v1.0.4 Online</span>
        </div>
        <h1 class="game-title">Play<span>X</span></h1>
        <p class="game-subtitle">Enter the Cyber Arena & Dominate</p>
    </div>

    <div class="menu-card mud-elevation-z8">
        <MudButton Class="menu-btn play-btn" FullWidth="true" OnClick="GameSelection" Size="Size.Large" Variant="Variant.Filled">
            <div class="btn-content">
                <MudIcon Class="btn-icon" Icon="@Icons.Material.Filled.PlayArrow" />
                <span>Play Now</span>
            </div>
        </MudButton>

        <MudButton Class="menu-btn custom-btn" FullWidth="true" OnClick="OpenAvatarCustomizer" Size="Size.Large" Variant="Variant.Outlined">
            <div class="btn-content">
                <MudIcon Class="btn-icon" Icon="@Icons.Material.Filled.Face" />
                <span>Customize Avatar</span>
            </div>
        </MudButton>

        <MudButton Class="menu-btn settings-btn" FullWidth="true" OnClick="OpenOptions" Size="Size.Large" Variant="Variant.Text">
            <div class="btn-content">
                <MudIcon Class="btn-icon" Icon="@Icons.Material.Filled.Settings" />
                <span>Options</span>
            </div>
        </MudButton>
    </div>

    <div class="footer-info">
        <div class="stat-item">
            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
            <span>1,420 Players Online</span>
        </div>
        <span class="separator">•</span>
        <div class="stat-item">
            <MudIcon Icon="@Icons.Material.Filled.SignalCellularAlt" Size="Size.Small" />
            <span>14ms</span>
        </div>
    </div>
</div>