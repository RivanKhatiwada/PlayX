@page "/game/solo/{GameSlug}"
@using PlayX.Components.Games

<PageTitle>PlayX - Solo @GameSlug</PageTitle>

<div class="pa-6 max-w-screen-md mx-auto">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <h1 class="text-h5 font-weight-bold">Solo Mode: @GameSlug</h1>
            <span class="mud-text-secondary">Mode: <strong>Single Player vs AI</strong></span>
        </div>
        <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">Solo Session</MudChip>
    </div>

    <div class="pa-6 rounded-2xl bg-surface border shadow-sm d-flex flex-column align-items-center">
        <DynamicGameLoader GameSlug="@GameSlug" IsOnline="false" IsHost="true" IsSolo="true" />
    </div>
</div>

@code {
    [Parameter] public string GameSlug { get; set; } = string.Empty;
}