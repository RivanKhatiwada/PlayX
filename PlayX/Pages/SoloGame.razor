@page "/game/offline/{GameSlug}"

<PageTitle>PlayX - Solo @GameSlug</PageTitle>

<div class="pa-6">
    <div class="d-flex justify-space-between align-center mb-4">
        <h1 class="text-h5 font-weight-bold">Solo Arena: @GameSlug</h1>
        <span class="mud-text-secondary">Mode: <strong>Offline Practice</strong></span>
    </div>

    <div class="pa-4 rounded-lg bg-surface border">
        <p>Running entirely local against AI bot...</p>
    </div>
</div>